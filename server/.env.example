PORT=5000
NODE_ENV=development
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# PostgreSQL Connection String
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/peoplepay360_db

# Or individual DB variables:
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=peoplepay360_db
